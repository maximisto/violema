# INERT PREPARATION ONLY. Do not include alongside the active vhost.
# Rendered by deploy/scientific-site/render.mjs; see migration handoff.
# One EXISTING backend/state/scheduler. No second process is created.
# LOOPBACK ONLY. Requires a separately approved local backend fixture on :3001.
# Place these map directives in nginx http context, never inside server.
map "$request_method:$request_uri" $scientific_browser_redirect {
    default "";
    "~^(?:GET|HEAD):/(?:login|signup|access-terms|plans|pricing|settings(?:/billing)?|connect/slack|integrations|admin|dashboard(?:/agents)?|runs/[A-Za-z0-9_-]+)/?$" "http://127.0.0.1:8089$request_uri#";
    "~^(?:GET|HEAD):/(?:plans|pricing)\?(?:section=topups|plan=(?:pro|team)|checkout=(?:success|cancel))$" "http://127.0.0.1:8089$request_uri#";
    "~^(?:GET|HEAD):/dashboard\?(?:panel=schedules|checkout=(?:success|cancel))$" "http://127.0.0.1:8089$request_uri#";
    "~^(?:GET|HEAD):/(?:login|signup|access-terms|connect/slack)\?next=(?:%2[Ff]|/)(?:dashboard|plans|pricing)$" "http://127.0.0.1:8089$request_uri#";
}
map $uri $scientific_protected_path {
    default 0;
    "~*(?:^/(?:backend|frontend|deploy|company-site|docs|node_modules)(?:/|$)|(?:^|/)\.[^/]*(?:/|$)|(?:\.(?:bak|map|env|rtf)$)|^/(?:AGENTS|CLAUDE)\.md$)" 1;
}
server {
    listen 127.0.0.1:8088;
    server_name localhost;
    # Return-only if is intentional: protect source paths before ^~ locations.
    if ($scientific_protected_path) { return 404; }
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin always;
    location = /api {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
    root /var/www/nexus/company-site/dist;
    location = / {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /index.html =404;
    }
    location = /index.html {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /index.html =404;
    }
    location = /method {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /method/index.html =404;
    }
    location = /method/ {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /method/index.html =404;
    }
    location = /demo {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /demo/index.html =404;
    }
    location = /demo/ {
