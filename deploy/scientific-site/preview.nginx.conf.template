        try_files $uri $uri/index.html =404;
    }
    location = /violema-icon.svg {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        root /var/www/nexus/frontend/dist;
        try_files $uri $uri/index.html =404;
    }
    location = /violema-mark.svg {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        root /var/www/nexus/frontend/dist;
        try_files $uri $uri/index.html =404;
    }
    location = /33bbbde5b8700c2c95901a438260d51d.txt {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        root /var/www/nexus/frontend/dist;
        try_files $uri $uri/index.html =404;
    }
    # Unknown/sensitive queries stay on the original host; no token transfer.
    location ~ "^(?:/(?:login|signup|access-terms|plans|pricing|settings(?:/billing)?|connect/slack|integrations|admin|dashboard(?:/agents)?|runs/[A-Za-z0-9_-]+)|/(?:faq|privacy|terms))/?$" {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        if ($scientific_browser_redirect != "") { return 302 $scientific_browser_redirect; }
        root /var/www/nexus/frontend/dist;
        try_files /index.html =404;
    }
    # Scientific routes never fall through into the legacy SPA.
    location / { return 404; }
}
