        try_files /legal/terms/index.html =404;
    }
    location = /legal/terms/index.html {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /legal/terms/index.html =404;
    }
    location = /legal/privacy {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /legal/privacy/index.html =404;
    }
    location = /legal/privacy/ {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /legal/privacy/index.html =404;
    }
    location = /legal/privacy/index.html {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /legal/privacy/index.html =404;
    }
    location = /robots.txt {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /robots.txt =404;
    }
    location = /sitemap.xml {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /sitemap.xml =404;
    }
    location = /llms.txt {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files /llms.txt =404;
    }
    location ^~ /company-assets/ {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files $uri =404;
    }
    # The old workspace app moved to agent.purpleorange.ai: its pages, assets and
    # unknown paths are the company 404 page, never a redirect or the legacy SPA.
    location / { return 404; }
}
